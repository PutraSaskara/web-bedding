# Base Backend API URL (contoh: http://localhost:5000/api atau URL produksi)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api

# Shared API Key untuk komunikasi ke backend (dikirim via header X-Api-Key)
WEB_API_KEY=your_shared_web_api_key_secret

# URL Domain Web Utama (untuk sitemap & canonical)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
